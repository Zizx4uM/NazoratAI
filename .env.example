# NazoratAI Environment Configuration Example
# Copy this file to .env to configure optional LLM document review capabilities.

# Google Gemini API key (optional, unlocks Gemini 1.5 Flash review of monitoring acts)
GEMINI_API_KEY=

# OpenAI API key (optional fallback)
OPENAI_API_KEY=

# Application Server Settings
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501
